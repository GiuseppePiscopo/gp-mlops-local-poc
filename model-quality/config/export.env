KUBE_CONTEXT=kind-mlops-test
KUBERNETES_NAMESPACE=gp-mof-capstone-serving
POD_LABEL=app=isvc.gp-mof-capstone-model-predictor
LOG_SINCE=24h

SEAWEEDFS_CONTAINER_NAME=mlops-seaweedfs
SEAWEEDFS_DOCKER_NETWORK=mlops-local-network
SEAWEEDFS_S3_PORT=8333

MLFLOW_ENV_FILE=/opt/mlops-local-poc/mlflow/.env

LOG_BUCKET=mlops-logs
LOG_PREFIX=inference
AWS_CLI_IMAGE=amazon/aws-cli
