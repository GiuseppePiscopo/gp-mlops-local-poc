# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Datasets
###*.csv
*.tgz

# Python virtual environments
venv/
.venv/

# dotenv environment variable files
.env.*.local
.env.local

# TensorFlow Serving model versions hosted locally (generated at deploy time);
# keep the config files that live directly in the folder tracked
phase_0/final_project/serving/*/

# Azure ML downloaded Explanation data
phase_1/**/download_explanation/

# Local output data
outputs/

# MLflow runs data
mlruns/
mlflow.db

# Output diagrams
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
