# -----------------------------------------------------------------------------
# PostgreSQL: MLflow backend store
# -----------------------------------------------------------------------------

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# MLflow Tracking Server
# -----------------------------------------------------------------------------

MLFLOW_HOST_PORT=5000

# -----------------------------------------------------------------------------
# SeaweedFS: S3-compatible artifact store
# -----------------------------------------------------------------------------

S3_BUCKET=mlflow-artifacts
S3_REGION=us-east-1

S3_ACCESS_KEY_ID=mlflow
S3_SECRET_ACCESS_KEY=replace-with-a-local-s3-secret

# Exposed only on the WSL loopback interface by compose.yaml
S3_HOST_PORT=8333
SEAWEEDFS_MASTER_HOST_PORT=9333
SEAWEEDFS_FILER_HOST_PORT=8888
